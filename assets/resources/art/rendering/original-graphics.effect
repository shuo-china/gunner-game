// Creator Graphics vertex layout; color decoded before premultiplied blending.
CCEffect %{
  techniques:
  - passes:
    - vert: graphics-vs:vert
      frag: graphics-fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      depthStencilState:
        depthTest: false
        depthWrite: false
}%
CCProgram graphics-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec4 a_color;
  in float a_dist;
  out vec4 color;
  out float dist;
  vec4 vert () {
    color = a_color; dist = a_dist;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%
CCProgram graphics-fs %{
  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 300])
  precision highp float;
  in vec4 color;
  in float dist;
  vec4 frag () {
    #if __VERSION__ < 300
      #ifdef GL_OES_standard_derivatives
        float aa = fwidth(dist);
      #else
        float aa = 0.05;
      #endif
    #else
      float aa = fwidth(dist);
    #endif
    float alpha = color.a * (1.0 - smoothstep(-aa, 0.0, abs(dist) - 1.0));
    vec3 c = mix(color.rgb / 12.92, pow((color.rgb + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), color.rgb));
    return vec4(c * alpha, alpha);
  }
}%
