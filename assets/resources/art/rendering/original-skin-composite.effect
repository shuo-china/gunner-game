// The cached UI target contains premultiplied linear RGB and coverage alpha.
// Background capture stays sRGB, matching the existing gameplay/HUD rendering.
CCEffect %{
  techniques:
  - passes:
    - vert: skin-composite-vs:vert
      frag: skin-composite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: false
      rasterizerState:
        cullMode: none
      properties:
        backgroundTexture: { value: black }
}%
CCProgram skin-composite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #include <common/common-define>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord;
    // Both captures use the same target size and render-texture orientation.
    CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    return cc_matViewProj * pos;
  }
}%
CCProgram skin-composite-fs %{
  precision highp float;
  in vec2 uv0;
  uniform sampler2D backgroundTexture;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec3 decodeSrgb(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
  }
  vec3 encodeSrgb(vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
  }
  vec4 frag () {
    vec4 ui = texture(cc_spriteTexture, uv0);
    vec3 background = texture(backgroundTexture, uv0).rgb;
    return vec4(encodeSrgb(ui.rgb + decodeSrgb(background) * (1.0 - ui.a)), 1.0);
  }
}%
