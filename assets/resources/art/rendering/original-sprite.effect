// Sprite interface follows Creator 3.8.8 builtin-sprite.effect.
// The world target stores linear LDR; only its presentation pass encodes sRGB.
CCEffect %{
  techniques:
  - passes:
    - vert: original-vs:vert
      frag: original-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        bowOutlineParams: { value: [0.00390625, 0.006993007, 3.5, 0] }
        bowOutlineColor: { value: [0.298039216, 0.192156863, 0.117647059, 1] }
        skinFurColor: { value: [0.97254902, 0.59215686, 0.22352941, 1] }
        skinBodyTemplate: { value: white }
        skinBodyArtworkFit: { value: [0.32, 0.91, 0.78, 0] }
        skinBodyHemReference: { value: [0.22, 0.62, 0, 0] }
}%
CCProgram original-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram original-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #if SKIN_BODY_TEMPLATE
    uniform sampler2D skinBodyTemplate;
  #endif
  #if SKIN_BODY_ART_FIT
    uniform SkinBodyArtwork {
      vec4 skinBodyArtworkFit;
      vec4 skinBodyHemReference;
    };
  #endif
  uniform BowOutline {
    // Source texel size, outline radius in source pixels, reserved.
    vec4 bowOutlineParams;
    vec4 bowOutlineColor;
  };
  #if SKIN_FUR_PALETTE
    uniform SkinPalette { vec4 skinFurColor; };
    // Recover the orange contribution in the source fur/cream/outline palette.
    // Working before sRGB decoding preserves the baked antialiased boundaries.
    vec3 recolorFur(vec3 rgb) {
      vec3 fur = vec3(248.0, 151.0, 57.0) / 255.0;
      vec3 outline = vec3(88.0, 63.0, 33.0) / 255.0;
      vec3 cream = vec3(255.0, 233.0, 193.0) / 255.0;
      vec3 f = fur - outline, c = cream - outline, p = rgb - outline;
      float ff = dot(f, f), cc = dot(c, c), fc = dot(f, c);
      float det = ff * cc - fc * fc;
      float weight = (dot(p, f) * cc - dot(p, c) * fc) / det;
      float creamWeight = (dot(p, c) * ff - dot(p, f) * fc) / det;
      // Clothing uses other pigments: leave colors outside the source palette
      // triangle untouched, including the gold, red and brown costume details.
      float error = length(p - f * weight - c * creamWeight);
      float mask = 1.0 - smoothstep(0.018, 0.045, error);
      mask *= 1.0 - smoothstep(0.03, 0.12, max(-creamWeight, weight + creamWeight - 1.0));
      return clamp(rgb + (skinFurColor.rgb - fur) * clamp(weight, 0.0, 1.0) * mask, 0.0, 1.0);
    }
  #endif
  vec3 decodeSrgb(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
  }
  vec3 encodeSrgb(vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
  }
  vec4 frag () {
    vec2 artworkUv = uv0;
    #if SKIN_BODY_ART_FIT
      // Only fit the lower clothing colors. Keep collar UVs, torso coverage and
      // foot registration unchanged; the canonical rim still samples uv0.
      float top = skinBodyArtworkFit.x;
      float sourceBottom = skinBodyArtworkFit.y;
      float visibleBottom = skinBodyArtworkFit.z;
      if (uv0.y > top) {
        artworkUv.y = mix(top, sourceBottom, min(1.0, (uv0.y - top) / (visibleBottom - top)));
      }
    #endif
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, artworkUv);
    #if SKIN_BODY_ART_FIT
      if (uv0.y > visibleBottom) {
        // Fill the revealed hem with fabric, never stretch the PNG's baked rim.
        // Column references preserve the monk's sash and the raincoat seam.
        vec2 hemUv = vec2(mix(skinBodyHemReference.x, uv0.x, skinBodyHemReference.z), skinBodyHemReference.y);
        o = CCSampleWithAlphaSeparated(cc_spriteTexture, hemUv);
      }
    #endif
    #if SKIN_BODY_TEMPLATE
      // Every unatlased torso uses the same UV registration and silhouette.
      // Keep the authored canonical brown rim and coverage; costumes supply
      // only the interior colors. This also applies to black locked silhouettes.
      vec4 body = texture(skinBodyTemplate, uv0);
      float rim = 1.0 - smoothstep(0.46, 0.54, max(body.r, max(body.g, body.b)));
      o.rgb = mix(o.rgb, body.rgb, rim);
      o.a = body.a;
    #endif
    #if ENCODE_OUTPUT
      // Opaque world image. HUD continues to use its own UI materials.
      o = vec4(encodeSrgb(o.rgb), 1.0);
    #elif ORIGINAL_HEALTH_FILL
      // Texture143 is stored sRGB. Unity decodes it before Shader232's own
      // tint/premultiply/cubic sequence; retain both distinct source steps.
      o.rgb = decodeSrgb(o.rgb) * vec3(0.505999982, 1.0, 0.36500001) * o.a;
      o.rgb = o.rgb * (o.rgb * (o.rgb * 0.305306011 + 0.682171111) + 0.012522878);
    #else
      #if SKIN_FUR_PALETTE
        o.rgb = recolorFur(o.rgb);
      #endif
      o.rgb = decodeSrgb(o.rgb);
      #if BOW_OUTLINE
        // Bow and crossbow sprites retain transparent padding and stay
        // outside dynamic atlases. Only coverage expands; opaque art is intact.
        vec2 d = bowOutlineParams.xy * bowOutlineParams.z;
        vec2 diagonal = d * 0.707106781;
        float edge = o.a;
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(d.x, 0.0)).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - vec2(d.x, 0.0)).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(0.0, d.y)).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - vec2(0.0, d.y)).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + diagonal).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - diagonal).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(diagonal.x, -diagonal.y)).a);
        edge = max(edge, CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(-diagonal.x, diagonal.y)).a);
        float behind = edge * bowOutlineColor.a * (1.0 - o.a);
        float coverage = o.a + behind;
        o.rgb = (o.rgb * o.a + decodeSrgb(bowOutlineColor.rgb) * behind) / max(coverage, 0.00001);
        o.a = coverage;
      #endif
      o.rgb *= decodeSrgb(color.rgb);
      o.a *= color.a;
      ALPHA_TEST(o);
    #endif
    return o;
  }
}%
